[gd_scene format=3 uid="uid://ouxiem75asvy"]

[ext_resource type="Script" uid="uid://do05hvlu6hyvh" path="res://scripts/quests/quest.gd" id="1_r6vpg"]

[sub_resource type="GDScript" id="GDScript_r6vpg"]
resource_name = "part_1"
script/source = "extends quest_part

var marker: Node
var area: Node

func start(_map, _player, _quest):
	marker = _player.get_node(\"%minimap\").create_marker(Vector2(-2784, -2592))
	area = _map.create_interaction_area(Vector2(-2784, -2592))
	area.interacted.connect(finish)
	await area.interacted
	var new_cutscene: cutscene = load(\"res://scenes/cutscenes/quest_1.tscn\").instantiate()
	_quest.get_parent().create_cutscene(new_cutscene, {})
	marker.queue_free()
	player_stats_handler.coins += 45
	finish()
	
func finish():
	marker.queue_free()
	exit.emit()
"

[node name="quest" type="Node" unique_id=403987181]
script = ExtResource("1_r6vpg")
dialogue_text = "Ive got 2 Pizzas for you to deliver. They need to go a bit further away, if you want to get there faster just use your car."
