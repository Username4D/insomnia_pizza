[gd_scene format=3 uid="uid://b5yacaa3cy603"]

[ext_resource type="Script" uid="uid://do05hvlu6hyvh" path="res://scripts/quests/quest.gd" id="1_br1vi"]

[sub_resource type="GDScript" id="GDScript_0ep2c"]
script/source = "extends quest_part

func start(_map, _player, _quest):
	var area = _map.create_interaction_area(Vector2(2848,1440))
	var marker = _player.get_node(\"%minimap\").create_marker(Vector2(2848,1440))
	await area.interacted
	var new_cutscene: cutscene = load(\"res://scenes/cutscenes/quest_2.tscn\").instantiate()
	_quest.get_parent().create_cutscene(new_cutscene, {})
	marker.queue_free()
	player_stats_handler.coins += 25
	exit.emit()
"

