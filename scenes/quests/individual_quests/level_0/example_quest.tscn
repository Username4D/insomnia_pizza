[sub_resource type="GDScript" id="GDScript_l0au0"]
script/source = "extends quest_part

func start(_map, _player, _quest):
	var area = _map.create_interaction_area(Vector2(500,500))
	var marker = _player.get_node(\"%minimap\").create_marker(Vector2(500, 500))
	await area.interacted
	var new_cutscene: cutscene = load(\"res://scenes/demo_cutscene.tscn\").instantiate()
	_quest.get_parent().create_cutscene(new_cutscene, {})
	marker.queue_free()
"

